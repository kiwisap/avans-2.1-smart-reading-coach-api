# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces mean a line break in Markdown
trim_trailing_whitespace = false

[package-lock.json]
# Generated by npm
indent_size = 2
