PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (relational data: users, books, preferences, reading history)
POSTGRES_URL=postgresql://coach:coach@localhost:5432/smart_reading_coach

# MongoDB (file/object storage: book covers, import files)
MONGO_URL=mongodb://localhost:27017
MONGO_DB=smart_reading_coach_files

# Auth (generate a long random value, never commit the real one)
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# AI service (smart-reading-coach-ai). Leave AI_SERVICE_URL empty to use the rule based advice only.
# AI_API_KEY must be the same value as AI_API_KEY in the AI service.
AI_SERVICE_URL=http://localhost:8000
AI_API_KEY=
AI_TIMEOUT_MS=3000
