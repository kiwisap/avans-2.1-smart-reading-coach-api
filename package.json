{
    "name": "smart-reading-coach-api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Fastify backend for Smart Reading Coach (Vrij lezen op maat)",
    "scripts": {
        "dev": "tsx watch --env-file=.env src/server.ts",
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "build": "npm run clean && tsc -p tsconfig.build.json",
        "start": "node --env-file=.env dist/server.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node --import tsx --test \"tests/**/*.test.ts\"",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
        "db:seed": "tsx --env-file=.env src/db/seed.ts",
        "import:catalog": "tsx --env-file=.env src/scripts/importCatalog.ts"
    },
    "engines": {
        "node": ">=20.6"
    },
    "dependencies": {
        "@fastify/cors": "^11.3.0",
        "@fastify/jwt": "^10.2.2",
        "bcryptjs": "^3.0.3",
        "dotenv": "^18.0.4",
        "drizzle-orm": "^0.45.3",
        "exceljs": "^4.4.0",
        "fastify": "^5.12.5",
        "fastify-plugin": "^6.0.0",
        "mongodb": "^7.7.0",
        "pg": "^8.23.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.3",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.11",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.12.0",
        "prettier": "^3.9.9",
        "tsx": "^4.23.15",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.71.0"
    }
}
